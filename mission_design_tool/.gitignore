# Build artefact: regenerated by build_standalone.py from the sources and data/
# alongside it, and rebuilt in CI on every deploy.
dist/

# data/ and logos/ are deliberately NOT ignored. GitHub Pages serves this
# directory as-is with no build step, and data/ cannot be regenerated from a
# clean checkout — build_data.py reads outputs/model/, which is gitignored. If
# these are missing the deployed page has nothing to draw.
